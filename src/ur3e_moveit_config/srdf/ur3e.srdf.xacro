  <!-- robotiq left inner knuckle pairs -->
  <disable_collisions link1="robotiq_140_left_inner_knuckle" link2="robotiq_140_left_outer_finger" reason="Never"/>
  <disable_collisions link1="robotiq_140_left_inner_knuckle" link2="robotiq_140_left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="robotiq_140_left_inner_knuckle" link2="robotiq_140_right_inner_finger" reason="Never"/>
