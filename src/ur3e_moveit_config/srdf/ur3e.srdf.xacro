  <disable_collisions link1="robotiq_140_left_inner_knuckle" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="robotiq_140_left_inner_knuckle" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="robotiq_140_left_inner_knuckle" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="robotiq_140_left_inner_knuckle" link2="wrist_2_link" reason="Never"/>
