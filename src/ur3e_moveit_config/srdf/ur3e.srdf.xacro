  <disable_collisions link1="forearm_link" link2="robotiq_140_right_outer_finger" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="robotiq_140_right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="robotiq_140_robotiq_140_base_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="shoulder_link" reason="Default"/>
  <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_2_link" reason="Default"/>
  <disable_collisions link1="forearm_link" link2="wrist_3_link" reason="Default"/>

  <!-- robotiq left inner finger pairs -->
  <disable_collisions link1="robotiq_140_left_inner_finger" link2="robotiq_140_left_inner_finger_pad" reason="Adjacent"/>
  <disable_collisions link1="robotiq_140_left_inner_finger" link2="robotiq_140_left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="robotiq_140_left_inner_finger" link2="robotiq_140_left_outer_finger" reason="Adjacent"/>
  <disable_collisions link1="robotiq_140_left_inner_finger" link2="robotiq_140_left_outer_knuckle" reason="Never"/>
  <disable_collisions link1="robotiq_140_left_inner_finger" link2="robotiq_140_right_inner_finger" reason="Never"/>
  <disable_collisions link1="robotiq_140_left_inner_finger" link2="robotiq_140_right_inner_finger_pad" reason="Never"/>
  <disable_collisions link1="robotiq_140_left_inner_finger" link2="robotiq_140_right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="robotiq_140_left_inner_finger" link2="robotiq_140_right_outer_finger" reason="Never"/>
  <disable_collisions link1="robotiq_140_left_inner_finger" link2="robotiq_140_right_outer_knuckle" reason="Never"/>
