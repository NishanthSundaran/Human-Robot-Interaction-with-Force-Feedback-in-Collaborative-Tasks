<?xml version="1.0"?>
<sdf version="1.6">
  <world name="assistive_lift_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Ignition systems -->
    <plugin filename="ignition-gazebo-forcetorque-system"
            name="ignition::gazebo::systems::ForceTorque"/>
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-forcetorque-system"
            name="ignition::gazebo::systems::ForceTorque"/>
    <plugin filename="ignition-gazebo-apply-link-wrench-system"
            name="ignition::gazebo::systems::ApplyLinkWrench"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <!-- Sun light (required for camera sensors to see anything) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Robot table: aluminum extrusion frame + wooden mounting plate.
      Real dimensions: 0.6 x 0.6 x 0.63m (height).
      Robot base_link sits on top at z=0.63.
      Table centre at (0, 0, 0.315) in world frame.
    -->
    <model name="robot_table">
      <static>true</static>
      <pose>0 0 0.315 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 0.63</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.63</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Workspace table: standard table, 8 cm higher than robot table.
      Real dimensions: 0.8 x 1.2 x 0.74m (height).
      Position adjusted in Gazebo UI to match real-world layout.
    -->
    <model name="workspace_table">
      <static>true</static>
      <pose>-0.6993 0 0.37 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 1.2 0.74</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 1.2 0.74</size></box>
          </geometry>
          <material>
            <ambient>0.45 0.35 0.25 1</ambient>
            <diffuse>0.55 0.40 0.28 1</diffuse>
            <specular>0.2 0.15 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Grasp box: 6.5 x 3 x 6 cm (same as real-world object).
      Placed on workspace table, within UR3e reach.
        base_link position: (0.0, 0.35, ~0.14)
        Gazebo world: x = -base_y = -0.35, y = base_x = 0.0
                      z = 0.74 (table top) + 0.03 (half box) = 0.77
    -->
    <model name="grasp_box">
      <static>false</static>
      <pose>-0.35 0.0 0.77 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.0000465</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000591</iyy><iyz>0</iyz>
            <izz>0.0000381</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.065 0.03 0.06</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.065 0.03 0.06</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
            <specular>0.3 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
